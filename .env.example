# Konfigurasi compose aplikasi SKPI (salin ke .env; .env tidak masuk Git).

# --- Jaringan Fabric (samakan dengan onchain/network/.env) ---
FABRIC_DOMAIN=unila.local
PEER1_IP=192.168.56.11
PEER2_IP=192.168.56.12
FABRIC_CHANNEL=skpi-channel
FABRIC_CHAINCODE=skpi
FABRIC_MSP_ID=UnilaMSP

# --- PostgreSQL ---
POSTGRES_DB=skpi
# Superuser hanya untuk kontainer postgres (inisialisasi); aplikasi memakai APP_DB_USER (bukan superuser).
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=ganti-sandi-admin-db
APP_DB_USER=skpi_app
APP_DB_PASSWORD=ganti-sandi-aplikasi-db

# --- Sesi ---
# Minimal 32 karakter acak, mis. hasil: openssl rand -base64 48
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
# true di production (HTTPS). false hanya untuk uji lokal lewat http://localhost.
COOKIE_SECURE=true

# --- Ledger: batas waktu (ms) dan rekonsiliasi ---
# Jumlah endorse + submit + commit harus di bawah proxy_read_timeout nginx (120 s).
FABRIC_READER_IDENTITY=app-reader
FABRIC_EVALUATE_TIMEOUT_MS=5000
FABRIC_ENDORSE_TIMEOUT_MS=15000
FABRIC_SUBMIT_TIMEOUT_MS=20000
FABRIC_COMMIT_TIMEOUT_MS=60000
RECONCILE_INTERVAL_MS=15000
RECONCILE_GIVE_UP_MS=600000

# --- Batas permintaan per IP per menit ---
VERIFY_RATE_LIMIT_PER_MIN=30
LOGIN_RATE_LIMIT_PER_MIN=10
# Jumlah proxy tepercaya di depan backend: 1 = hanya nginx frontend; 2 = ada reverse proxy HTTPS lagi di depannya
# (mis. di EC2). Salah isi → batas per IP berlaku untuk semua orang sekaligus, atau IP bisa dipalsukan.
TRUST_PROXY=1

# --- Akses HTTP frontend ---
# 127.0.0.1 = hanya dari mesin ini (di belakang reverse proxy HTTPS); 0.0.0.0 = semua antarmuka.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
LOG_LEVEL=info

# --- Production (hanya dipakai docker-compose.prod.yml) ---
# Domain publik untuk sertifikat HTTPS otomatis (Caddy). DNS A record harus sudah mengarah ke server.
APP_DOMAIN=unilachain.deaal.dev
