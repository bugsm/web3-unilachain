# Dirender oleh entrypoint nginx (envsubst) saat start: hanya ${BACKEND_URL} dan ${NGINX_RESOLVER} yang diganti.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # DNS bawaan Docker (jaringan user-defined/compose). Ganti lewat NGINX_RESOLVER bila perlu.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # API diteruskan ke backend; IP asli dibutuhkan rate limit endpoint verifikasi publik.
    location /api/ {
        # Host di-resolve per permintaan: nginx tetap hidup bila backend belum ada dan mengikuti IP baru saat backend dibuat ulang.
        # proxy_pass lewat variabel tanpa URI meneruskan path asli /api/... ke backend.
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Di atas total batas waktu transaksi backend (endorse 15 s + submit 5 s + commit 60 s), agar klien menerima
        # jawaban JSON backend (mis. 503 COMMIT_UNKNOWN), bukan 504 HTML dari nginx.
        proxy_read_timeout 120s;
    }

    # Aset ber-hash dari Vite: cache panjang.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA: semua rute lain ke index.html, tanpa cache.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
