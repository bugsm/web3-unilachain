{
  "name": "skpi-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "user:create": "tsx scripts/user-create.ts",
    "typecheck": "tsc --noEmit",
    "test": "mocha \"test/unit/**/*.test.ts\"",
    "test:db": "mocha \"test/db/**/*.test.ts\"",
    "test:fabric": "mocha --timeout 60000 \"test/fabric/**/*.test.ts\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@hyperledger/fabric-protos": "^0.3.7",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
