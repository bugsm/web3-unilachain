{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node", "mocha"],
    "baseUrl": ".",
    "paths": { "@/*": ["../frontend/src/*"] }
  },
  "include": ["src", "scripts", "test"]
}
